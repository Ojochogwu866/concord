{
  "name": "sitehealth",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:css": "tailwindcss -i sitehealth/static_src/css/main.css -o sitehealth/static/css/main.css --minify",
    "watch:css": "tailwindcss -i sitehealth/static_src/css/main.css -o sitehealth/static/css/main.css --watch=always",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
